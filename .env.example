# Server-only. Never prefix with PUBLIC_ — the browser must not see these.
# Base URL of the Nostos Real API (Fastify), e.g. http://localhost:4000 in dev.
# The browser calls same-origin /api/... ; the server forwards to API_URL.
API_URL=http://localhost:4000

# --- Overview dashboard (/admin) -------------------------------------------
# Public, display-only settings (read at runtime, no rebuild needed). They
# reshape the board; role permissions still decide what each user sees.
# All optional: unset or invalid values fall back to the defaults shown.

# Where chart history comes from: mock (seeded, generated) | live (bucketed
# from loaded records; metrics without API history show an empty state).
PUBLIC_DASHBOARD_SOURCE=mock
# Widgets and their order: kpis,trend,attention,pipeline,upcoming,activity,galleries,archive
PUBLIC_DASHBOARD_WIDGETS=kpis,trend,attention,pipeline,upcoming,activity,galleries,archive
# KPI tiles and their order: revenue,requests,bookings,orders,views,uploads,outstanding,conversion
PUBLIC_DASHBOARD_KPIS=revenue,requests,conversion,outstanding
# Metric the trend chart opens on: revenue|requests|bookings|orders|views|uploads
PUBLIC_DASHBOARD_METRIC=revenue
# Default period: 7d|30d|90d|12m (a ?range= query parameter overrides it)
PUBLIC_DASHBOARD_RANGE=30d
# Layout spacing: comfortable|compact
PUBLIC_DASHBOARD_DENSITY=comfortable
# Monthly revenue goal in whole currency units; 0 hides the goal bar.
PUBLIC_DASHBOARD_REVENUE_GOAL=0
# Mock source only: same seed, same history.
PUBLIC_DASHBOARD_SEED=nostos
# Mock source only: volume multiplier (0.1–50).
PUBLIC_DASHBOARD_SCALE=1
# Mock source only: growth per 30 days (-0.9–3), e.g. 0.1 = +10%, -0.2 = -20%.
PUBLIC_DASHBOARD_TREND=0.06
# Mock source only: seconds between simulated live events; 0 turns them off.
PUBLIC_DASHBOARD_TICK_SECONDS=25
